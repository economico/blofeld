{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blofeld-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "blofeld.dev", "custom_domain": true },
    { "pattern": "www.blofeld.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
